{
  "name": "@banyudu/workit",
  "version": "0.1.4",
  "description": "Unified Linear and GitHub issue worktree launcher",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banyudu/workit.git"
  },
  "bugs": {
    "url": "https://github.com/banyudu/workit/issues"
  },
  "homepage": "https://github.com/banyudu/workit#readme",
  "keywords": [
    "cli",
    "worktree",
    "linear",
    "github",
    "coding-agent"
  ],
  "type": "module",
  "bin": {
    "workit": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
